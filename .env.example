# Keycloak Admin Configuration
# Copy this file to .env and update the values with your own secure credentials
# IMPORTANT: Add .env to your .gitignore file to prevent credentials from being committed

# Keycloak Admin User Credentials
# Default: admin / change_me_in_production (CHANGE THESE!)
KEYCLOAK_ADMIN=your_admin_username
KEYCLOAK_ADMIN_PASSWORD=your_secure_admin_password

# MySQL Database Credentials for Keycloak
# Current defaults: root / password (CHANGE THESE FOR PRODUCTION!)
MYSQL_ROOT_PASSWORD=your_mysql_root_password
MYSQL_PASSWORD=your_keycloak_database_password

# Instructions:
# 1. Copy this file: cp .env.example .env
# 2. Update the values above with your own secure credentials
# 3. Ensure .env is in your .gitignore file
# 4. Start the services: docker compose up -d
#
# Note: Without this .env file, the services will use default passwords
# (root/password/admin) which are fine for development but NOT for production!

