#Environment Variables File Example

#Azure Entra ID Values
AZURE_CLIENT_ID=your-client-id-here
AZURE_TENANT_ID=your-tenant-id-here
AZURE_APP_ID_URI=api://your-client-id-here

# Production service URLs (required when SPRING_PROFILES_ACTIVE=prod)
# Set these in Azure Container App / App Service environment configuration
PRODUCT_SERVICE_URL=https://product-service.your-azure-domain.com
ORDER_SERVICE_URL=https://order-service.your-azure-domain.com
INVENTORY_SERVICE_URL=https://inventory-service.your-azure-domain.com
